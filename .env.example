# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development           # development | production | test
PORT=8000                      # HTTP port the server listens on

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=                    # Strong random secret for signing JWTs
JWT_EXPIRES_IN=7d              # Token expiry e.g. 7d, 24h

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=                   # Full MongoDB connection string

# ─── Game ────────────────────────────────────────────────────────────────────
DAILY_RESET_KEY=               # Secret key used to trigger the daily word reset endpoint

# ─── Client ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:8081  # Frontend base URL (used in password reset links)

# ─── Email — Brevo HTTP API (recommended, works on Railway) ──────────────────
# Get your API key from: Brevo dashboard → SMTP & API → API Keys
BREVO_API_KEY=                 # Brevo transactional API key (xkeysib-...)
EMAIL_FROM_ADDRESS=            # Verified sender address in your Brevo account
EMAIL_FROM_NAME=Wordle App     # Display name shown in the From field

# ─── Email — Legacy SMTP (local dev only, blocked by Railway) ────────────────
# These are no longer used in production. Kept here for local testing reference.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=                  # Brevo SMTP login (e.g. 123456@smtp-brevo.com)
# EMAIL_PASS=                  # Brevo SMTP password / key
# EMAIL_USER_TEST=             # Test account SMTP user
# EMAIL_PASS_TEST=             # Test account SMTP password
# GEMAIL_USER=                 # Gmail sender address (legacy)
